<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Основная тёмная карточка -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/broline_card" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/broline_outline" />
        </shape>
    </item>

    <!-- Подсветка при выборе карточки -->
    <item>
        <selector>

            <item
                android:state_activated="true"
                app:state_multiselected="true">
                <shape android:shape="rectangle">
                    <solid android:color="#332B54FF" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/broline_blue" />
                </shape>
            </item>

            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/broline_ripple" />
                    <corners android:radius="14dp" />
                </shape>
            </item>

            <item>
                <color android:color="@android:color/transparent" />
            </item>

        </selector>
    </item>

    <!-- Сохраняем стандартный эффект нажатия -->
    <item android:drawable="?attr/selectableItemBackground" />

</layer-list>
